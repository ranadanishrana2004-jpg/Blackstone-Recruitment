PORT=4174
HOST=127.0.0.1
NODE_ENV=development
APP_ORIGIN=http://127.0.0.1:4174
DATA_DIR=./platform/data
# For production: NODE_ENV=production, HOST=0.0.0.0, APP_ORIGIN=https://your-domain
# Put a TLS reverse proxy in front of the server and use a persistent DATA_DIR volume.
# Optional AI review: candidates must explicitly opt in before any CV is sent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Transactional email: set provider and key only after verifying the sender.
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
ENQUIRY_NOTIFY_EMAIL=info@bsukrecruitment.com
# Optional legacy provider (EMAIL_PROVIDER=resend):
RESEND_API_KEY=
EMAIL_FROM=Blackstone UK Recruitment <info@bsukrecruitment.com>

CONTACT_EMAIL=info@bsukrecruitment.com
